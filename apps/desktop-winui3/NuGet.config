<?xml version="1.0" encoding="utf-8"?>
<!--
  项目级 NuGet 配置。

  为什么需要这个文件：
  本机注册表里开着 IE/系统代理 127.0.0.1:10801，但那个代理进程并没有运行
  （「目标计算机积极拒绝」）。dotnet restore 默认会走系统代理，于是拉
  Microsoft.WindowsAppSDK 时全部失败（NU1301）。

  这里显式声明不走代理，并清空任何继承来的 proxy 配置，保证 restore 直连
  nuget.org（本机直连 nuget 是通的，302 正常）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <config>
    <add key="http_proxy" value="" />
    <add key="https_proxy" value="" />
    <add key="maxHttpRequestsPerSource" value="16" />
  </config>
</configuration>
