  background: rgba(15, 23, 42, 0.06);
  color: inherit;
}

/* 接口清单 */
.kb-endpoints {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 10px;
}
.kb-endpoint {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 6px 9px;
  border-radius: 7px;
  background: rgba(15, 23, 42, 0.035);
}
.kb-endpoint__method {
  flex: 0 0 auto;
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
  font-family: var(--font-mono, ui-monospace, monospace);
}
.kb-endpoint__method--post {
  color: #fff;
  background: #0f7b6c;
}
.kb-endpoint__method--get {
  color: var(--accent, #1677ff);
  background: color-mix(in srgb, var(--accent, #1677ff) 16%, transparent);
}
.kb-endpoint__path {
  flex: 1 1 auto;
  min-width: 0;
  font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  font-size: 11.5px;
  color: var(--fg, #1f2329);
  word-break: break-all;
}
.kb-endpoint__desc {
  flex: 0 0 auto;
  font-size: 11px;
  color: var(--fg-3, #8a8f99);
}

/* 代码块工具条 */
.kb-codebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 10px;
}
.kb-codebar__tabs {
  display: inline-flex;
  gap: 2px;
  padding: 2px;
  border-radius: 7px;
  background: rgba(15, 23, 42, 0.05);
}
.kb-codebar__tab {
  border: 0;
  cursor: pointer;
  padding: 3px 11px;
  border-radius: 5px;
  font-size: 11.5px;
  color: var(--fg-3, #8a8f99);
  background: transparent;
  transition: background 0.15s, color 0.15s;
}
.kb-codebar__tab.is-on {
  color: var(--fg, #1f2329);
  background: var(--bg, #fff);
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
}
.kb-codebar__actions {
  display: inline-flex;
  gap: 6px;
}

/* 代码块 */
.kb-code {
  margin: 6px 0 0;
  padding: 10px 12px;
  max-height: 320px;
  overflow: auto;
  border-radius: 8px;
  border: 1px solid var(--border, rgba(15, 23, 42, 0.08));
  background: #1e2430;
  color: #dfe3ea;
  font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  font-size: 11.5px;
  line-height: 1.6;
  white-space: pre;
  tab-size: 2;
}
.kb-code code {
  font: inherit;
  color: inherit;
}

.kb-details {
  margin-top: 8px;
}
.kb-details > summary {
  cursor: pointer;
  font-size: 11.5px;
  color: var(--accent, #1677ff);
  user-select: none;
}

/* 隐私提示 */
.kb-notice {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  margin-top: 10px;
  padding: 8px 10px;
  border-radius: 7px;
  font-size: 11.5px;
  line-height: 1.6;
  color: #0f7b6c;
  background: rgba(15, 123, 108, 0.08);
}
.kb-notice p {
  margin: 0;
}

/* 复制上下文 */
.kb-copyctx {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 10px;
  padding: 9px 11px;
  border-radius: 8px;
  border: 1px dashed var(--border, rgba(15, 23, 42, 0.14));
}
.kb-copyctx__text {
  flex: 1 1 260px;
  min-width: 0;
  font-size: 12px;
  color: var(--fg, #1f2329);
}
