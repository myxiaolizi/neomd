}
.kb-toggle {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--fg-2, #4b5058);
  cursor: pointer;
}
.kb-toggle input {
  accent-color: var(--accent, #1677ff);
  cursor: pointer;
}

/* 行内输入 */
.kb-inline {
  display: flex;
  align-items: center;
  gap: 8px;
}
.kb-inline .nm-input {
  flex: 1 1 auto;
  min-width: 0;
}

/* chip 列表 */
.kb-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 2px;
}
.kb-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 4px 2px 9px;
  font-size: 11px;
  border-radius: 999px;
  background: var(--bg-elevated, #f1f2f4);
  color: var(--fg-2, #4b5058);
  border: 1px solid var(--border, rgba(15, 23, 42, 0.08));
}
.kb-chip__x {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 15px;
  height: 15px;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: var(--fg-3, #8a8f99);
  cursor: pointer;
  padding: 0;
}
.kb-chip__x:hover {
  background: rgba(0, 0, 0, 0.08);
  color: var(--fg, #1f2329);
}

/* 提示条 */
.kb-tip {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  margin: 0;
  padding: 7px 10px;
  font-size: 12px;
  line-height: 1.5;
  border-radius: 7px;
  color: var(--fg-2, #4b5058);
  background: color-mix(in srgb, var(--accent, #1677ff) 7%, transparent);
}
.kb-error {
  margin: 0;
  padding: 7px 10px;
  font-size: 12px;
  line-height: 1.5;
  border-radius: 7px;
  color: #b42318;
  background: rgba(220, 38, 38, 0.08);
}
.kb-off {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 0;
  font-size: 12px;
  color: var(--fg-3, #8a8f99);
}
.notice {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  margin: 0;
  padding: 7px 10px;
  font-size: 12px;
  line-height: 1.5;
  border-radius: 7px;
  color: #8a6d3b;
  background: rgba(250, 173, 20, 0.1);
}

/* 命中结果 */
.kb-hits {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.kb-hit {
  padding: 9px 11px;
  border-radius: 8px;
  border: 1px solid var(--border, rgba(15, 23, 42, 0.08));
  background: var(--bg-elevated, #fbfbfc);
}
.kb-hit__head {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.kb-hit__idx {
  font-size: 11px;
  font-weight: 600;
  color: var(--accent, #1677ff);
  font-variant-numeric: tabular-nums;
}
.kb-hit__title {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 12px;
  font-weight: 600;
  color: var(--fg, #1f2329);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.kb-hit__score {
  font-size: 11px;
  font-variant-numeric: tabular-nums;
  color: var(--fg-3, #8a8f99);
}
.kb-hit__meta {
  margin: 3px 0 0;
  font-size: 11px;
  color: var(--fg-3, #8a8f99);
  word-break: break-all;
}
.kb-hit__text {
  margin: 5px 0 0;
  font-size: 12px;
  line-height: 1.6;
  color: var(--fg-2, #4b5058);
}
.kb-hit__text :deep(mark) {
  background: color-mix(in srgb, var(--accent, #1677ff) 22%, transparent);
  color: inherit;
  border-radius: 2px;
  padding: 0 1px;
}
.kb-hit__matched {
  margin: 5px 0 0;
  font-size: 11px;
  color: var(--fg-3, #8a8f99);
}
.kb-hit__kw {
  display: inline-block;
  margin-right: 4px;
  padding: 0 6px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--accent, #1677ff) 12%, transparent);
  color: var(--accent, #1677ff);
}

/* ---------- 如何给其他 AI / 智能体使用（1.1.7） ---------- */
.kb-guide {
  margin-top: 10px;
  padding: 11px 13px;
  border-radius: 9px;
