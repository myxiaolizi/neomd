}
.kb-guide__badge {
  flex: 0 0 auto;
  padding: 1px 7px;
  border-radius: 999px;
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: 0.02em;
}
.kb-guide__badge--inline {
  color: var(--accent, #1677ff);
  background: color-mix(in srgb, var(--accent, #1677ff) 14%, transparent);
}
.kb-guide__badge--api {
  color: #0f7b6c;
