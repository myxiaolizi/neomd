  margin: 4px 0 0;
}
.kb-tip--copy {
  margin-top: 8px;
}

@media (max-width: 720px) {
  .grid2 {
    grid-template-columns: 1fr;
  }
  .kb-stats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .kb-stat--action {
    grid-column: 1 / -1;
  }
