# 运行环境：production | development
NODE_ENV=production
# 监听端口与地址
PORT=3200
HOST=127.0.0.1
# SPA 静态资源目录（前端构建产物）
WEB_ROOT=/www/wwwroot/md.zhengl.vip/public

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=neomd
DB_PASSWORD=change-me-db-password
DB_NAME=neomd

# 访问令牌 / 刷新令牌签名密钥（各 64 位十六进制字符）
JWT_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-another-64-hex-chars
# 32 字节 base64，用于 AES-256-GCM 加密存储用户密钥
SECRETS_KEY=replace-with-32-bytes-base64

# 平台对象存储（S3 兼容）
# 阿里云 OSS 的 S3 兼容端点格式为 s3.oss-<region>.aliyuncs.com
# 腾讯云 COS / 火山 TOS / 自定义 MinIO 请按各自文档填写
OSS_ENDPOINT=https://s3.oss-cn-guangzhou.aliyuncs.com
OSS_REGION=cn-guangzhou
OSS_BUCKET=your-bucket
OSS_AK=your-access-key-id
OSS_SK=your-access-key-secret
OSS_PUBLIC_DOMAIN=https://your-public-domain.example.com
OSS_PREFIX=mdadmin/
# true：桶允许匿名读，发布页 302 跳转到公共域名；false：由服务端代理输出并把上传地址换成预签名
OSS_PUBLIC_READ=false

# 对外访问基址（分享 / 发布链接使用）
PUBLIC_BASE_URL=https://md.example.com

# 初始管理员：ADMIN_PASSWORD 留空则首次启动自动生成并打印一次
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
